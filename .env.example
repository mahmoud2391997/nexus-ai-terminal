# ============================================
# REQUIRED ENVIRONMENT VARIABLES
# The app will NOT boot without these set.
# ============================================

# PostgreSQL connection string (Prisma)
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://user:password@localhost:5432/nexus_ai_terminal"

# Secret key for NextAuth.js session encryption
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Google OAuth credentials (login)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# OPTIONAL ENVIRONMENT VARIABLES
# The app boots with only the required vars above.
# Each optional var enables a specific feature; when unset,
# the corresponding integration renders as "Not connected"
# and its tools are excluded from the model's tool list.
# ============================================

# --- AI / LLM (enables live streaming model responses) ---
# Any one of these enables the LLM; otherwise the agent uses its
# deterministic rule-based fallback for time/task/search commands.
# OpenAI-compatible key (also accepted: AI_GATEWAY_API_KEY)
OPENAI_API_KEY=""
# Mistral API key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=""
# Which model string to use. Defaults to "gpt-4o-mini".
# For Mistral use e.g. "mistral-large-latest". Never hardcode a
# model name in application logic; it is selected here.
AI_MODEL="gpt-4o-mini"

# --- Security (enables OAuth token encryption) ---
# AES-256-GCM encryption key for stored OAuth tokens.
# Generate with: openssl rand -base64 32   (must be >= 32 chars)
TOKEN_ENCRYPTION_KEY="your-token-encryption-key-min-32-chars"

# --- Integrations ---
# Phone calls (e.g. Twilio/Vonage)
PHONE_PROVIDER_API_KEY=""
PHONE_PROVIDER_API_SECRET=""

# WhatsApp (Twilio WhatsApp Business API). Reuses PHONE_PROVIDER_API_KEY/SECRET
# as the Twilio Account SID / Auth Token. WHATSAPP_FROM_NUMBER must be a
# WhatsApp-enabled Twilio number in international format, e.g. "+14155550100".
WHATSAPP_FROM_NUMBER=""

# --- Voice ---
# STT / TTS providers (voice still works with browser-native
# SpeechRecognition/SpeechSynthesis without these keys).
SPEECH_TO_TEXT_API_KEY=""
TEXT_TO_SPEECH_API_KEY=""

# --- Web search ---
# Choose ONE provider for live results. Without any, searchWeb
# returns a labeled fallback result.
#   - Serper: https://serper.dev
SERPER_API_KEY=""
#   - Tavily: https://tavily.com
TAVILY_API_KEY=""
#   - Generic web search API
WEB_SEARCH_API_KEY=""

# ============================================
# INTEGRATION NOTES
# ============================================
#
# Gmail/Calendar:
#   - Requires GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET (required anyway)
#   - Scopes are requested incrementally from Settings (not at signup)
#   - Requires TOKEN_ENCRYPTION_KEY for secure token storage
#   - Tools are excluded from the tool list until OAuth is connected
#
# Phone calls:
#   - Requires PHONE_PROVIDER_API_KEY + PHONE_PROVIDER_API_SECRET
#
# WhatsApp:
#   - Reuses PHONE_PROVIDER_API_KEY + PHONE_PROVIDER_API_SECRET
#   - Also requires WHATSAPP_FROM_NUMBER (a WhatsApp-enabled Twilio number)
#   - Enables the sendWhatsAppMessage tool
#
# Voice:
#   - Works without API keys via browser-native APIs
#   - Configure STT/TTS keys for production-grade providers
#
# Web search:
#   - Without a key, searchWeb returns a labeled fallback dataset
#   - Configure SERPER_API_KEY / TAVILY_API_KEY / WEB_SEARCH_API_KEY for live results
#