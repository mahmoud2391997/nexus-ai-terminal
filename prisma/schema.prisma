// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String?
  image             String?
  emailVerified     DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  accounts          Account[]
  sessions          Session[]
  oauthConnections  OAuthConnection[]
  conversations     Conversation[]
  tasks             Task[]
  toolExecutions    ToolExecution[]
  approvalRequests  ApprovalRequest[]
  automations      Automation[]
  auditLogs         AuditLog[]
  phoneCalls        PhoneCall[]
  contacts          Contact[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique
  userId        String
  expires       DateTime

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model OAuthConnection {
  id                      String            @id @default(cuid())
  userId                  String
  provider                String            // 'google', 'telegram', etc.
  accessTokenEncrypted    String            // AES-256-GCM encrypted
  refreshTokenEncrypted   String?           // AES-256-GCM encrypted
  expiresAt               DateTime?
  scopes                  String[]           // Array of granted scopes
  status                  OAuthStatus        @default(connected)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, provider])
}

enum OAuthStatus {
  connected
  expired
  revoked
}

model Conversation {
  id                String            @id @default(cuid())
  userId            String
  title             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          Message[]
  toolExecutions    ToolExecution[]
  approvalRequests  ApprovalRequest[]
}

model Message {
  id                String            @id @default(cuid())
  conversationId    String
  role              MessageRole
  content           String            @db.Text
  toolCalls         Json?             // Tool call metadata
  createdAt         DateTime          @default(now())
  
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

enum MessageRole {
  user
  assistant
  system
  tool
}

model ToolExecution {
  id                String              @id @default(cuid())
  userId            String
  conversationId    String?
  toolName          String
  input             Json                // Tool input parameters
  output            Json?               // Tool output result
  status            ToolExecutionStatus @default(PENDING)
  idempotencyKey     String?             // For idempotent retries
  startedAt         DateTime?
  completedAt       DateTime?
  error             String?
  createdAt         DateTime            @default(now())
  
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation      Conversation?       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  approvalRequests  ApprovalRequest[]
  phoneCalls        PhoneCall[]
  
  @@unique([userId, idempotencyKey])
}

enum ToolExecutionStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
}

model ApprovalRequest {
  id                String              @id @default(cuid())
  userId            String
  toolExecutionId   String?
  actionType        String
  payload           Json                // Action details for preview
  status            ApprovalStatus      @default(PENDING)
  expiresAt         DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime            @default(now())
  
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolExecution     ToolExecution?      @relation(fields: [toolExecutionId], references: [id], onDelete: Cascade)
  conversation      Conversation?       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId    String?
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Automation {
  id                String            @id @default(cuid())
  userId            String
  name              String
  definition        Json              // Trigger + actions definition
  status            AutomationStatus  @default(active)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs              AutomationRun[]
}

enum AutomationStatus {
  active
  paused
}

model AutomationRun {
  id                String              @id @default(cuid())
  automationId      String
  status            AutomationRunStatus @default(PENDING)
  startedAt         DateTime?
  completedAt       DateTime?
  error             String?
  idempotencyKey     String?            // For idempotent scheduler ticks
  
  automation        Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  
  @@unique([automationId, idempotencyKey])
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Task {
  id                String            @id @default(cuid())
  userId            String
  conversationId    String?
  title             String
  status            TaskStatus        @default(queued)
  dueAt             DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TaskStatus {
  queued
  in_progress
  completed
}

model Contact {
  id                String            @id @default(cuid())
  userId            String
  name              String
  email             String?
  phoneNumber       String?
  platform          String?           // 'telegram', 'whatsapp', etc.
  platformId        String?           // Platform-specific user ID
  metadata          Json?             // Additional contact data
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, platform, platformId])
}

model AuditLog {
  id                String            @id @default(cuid())
  userId            String
  actorType         ActorType
  action            String
  targetType        String?           // e.g., 'email', 'task', 'automation'
  targetId          String?           // ID of the affected resource
  metadata          Json?             // Additional context
  createdAt         DateTime          @default(now())
  
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
}

enum ActorType {
  user
  ai
  system
}

model PhoneCall {
  id                String            @id @default(cuid())
  userId            String
  toolExecutionId   String?
  phoneNumber       String
  objective         Json              // Structured call objective
  status            PhoneCallStatus   @default(PENDING)
  transcript        String?           @db.Text
  summary           String?           @db.Text
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime          @default(now())
  
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolExecution     ToolExecution?    @relation(fields: [toolExecutionId], references: [id], onDelete: Cascade)
}

enum PhoneCallStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}
